{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Prisma 7 emits its client as TypeScript source that imports with explicit
    // .ts extensions (e.g. './enums.ts'). allowImportingTsExtensions permits
    // that, and rewriteRelativeImportExtensions turns those specifiers into .js
    // on the way out - without it, TypeScript refuses to emit at all.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["node"]
  },
  "include": ["src/**/*.ts", "generated/**/*.ts", "prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}
