# Neon Postgres connection string.
# Neon dashboard -> Connection Details -> use the "Pooled connection" string.
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/gymreminder?sslmode=require"

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# JWT signing secret - generate with `openssl rand -base64 32`
JWT_SECRET=""

PORT=4000
NODE_ENV=development
