# Neon Postgres connection string.
# Neon dashboard -> Connect -> use the "Pooled connection" string.
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials).
# GOOGLE_CALLBACK_URL must be listed verbatim under "Authorized redirect URIs".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# Where the OAuth callback sends the browser once a session token exists.
FRONTEND_URL="http://localhost:3000"

# Minimum 32 characters - generate with `openssl rand -base64 32`
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development
